---
interface Props {
  uid: string;
  variant: 'fr265' | 'venu' | 'fenix';
}
const { uid, variant } = Astro.props;
const id = (n: string) => `${uid}-${n}`;
const url = (n: string) => `url(#${uid}-${n})`;
const buttons =
  variant === 'venu'
    ? [{ a: 58 }, { a: 100 }]
    : [{ a: -62 }, { a: -90 }, { a: -118 }, { a: 62 }, { a: 118 }];
const bezelW = variant === 'fenix' ? 15 : variant === 'venu' ? 6 : 11;
const screenR = variant === 'venu' ? 40 : variant === 'fenix' ? 32 : 36;
---

<svg class={`watch-mini wm-${variant}`} viewBox="0 0 160 240" width="160" height="240" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id('s')} x1="0" x2="1"><stop offset="0" stop-color="#0d0f12"></stop><stop offset=".5" stop-color="#2b3138"></stop><stop offset="1" stop-color="#0d0f12"></stop></linearGradient>
    <linearGradient id={id('m')} x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#eef1f5"></stop><stop offset=".25" stop-color="#8d95a1"></stop><stop offset=".5" stop-color="#20242a"></stop><stop offset=".78" stop-color="#7a828e"></stop><stop offset="1" stop-color="#cdd3dc"></stop></linearGradient>
    <radialGradient id={id('c')} cx=".35" cy=".28" r=".95"><stop offset="0" stop-color="#454c56"></stop><stop offset=".5" stop-color="#1a1d22"></stop><stop offset="1" stop-color="#090b0e"></stop></radialGradient>
    <linearGradient id={id('g')} x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"></stop><stop offset=".5" stop-color="#fff" stop-opacity=".22"></stop><stop offset="1" stop-color="#fff" stop-opacity="0"></stop></linearGradient>
    <clipPath id={id('k')}><circle cx="80" cy="120" r={screenR}></circle></clipPath>
  </defs>
  <path d="M55 -2H105L108 80H52Z" fill={url('s')}></path>
  <path d="M52 160H108L105 242H55Z" fill={url('s')}></path>
  <g class="wm-btns">
    {
      buttons.map((b) => (
        <rect x="76" y="62" width="8" height="12" rx="2.4" fill="#8d95a1" transform={`rotate(${b.a} 80 120)`}></rect>
      ))
    }
  </g>
  <circle cx="80" cy="120" r="56" fill={url('c')}></circle>
  <circle cx="80" cy="120" r="55.5" fill="none" stroke="#fff" stroke-opacity=".28"></circle>
  <circle cx="80" cy="120" r={46 - bezelW / 2 + 1} fill="none" stroke={url('m')} stroke-width={bezelW}></circle>
  {
    variant === 'fenix' && (
      <g stroke="#0c0e12" stroke-opacity=".55" stroke-width="1.3">
        {Array.from({ length: 12 }, (_, i) => <path d="M80 70v4" transform={`rotate(${i * 30} 80 120)`}></path>)}
      </g>
    )
  }
  <circle cx="80" cy="120" r={screenR + 2} fill="#020305"></circle>
  <g clip-path={url('k')}>
    <circle cx="80" cy="120" r={screenR} fill="#000"></circle>
    <path d="M80 98L94 124H66Z" fill="#2e5cf0"></path>
    <path d="M80 106L72 119H77V123H83V119H88Z" fill="#000"></path>
    <text x="80" y="141" text-anchor="middle" font-size="8.5" font-weight="700" fill="#fff" letter-spacing=".5">AIRLOG</text>
    <g class="wm-glint"><path d="M58 80L74 80L58 160L42 160Z" fill={url('g')}></path></g>
  </g>
</svg>
