---
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import '../styles/sections.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import dmSansFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'AIRLOG — Know how high you flew. Kitesurf jump tracker for Garmin',
  description = 'AIRLOG turns your Garmin watch into a kitesurf jump tracker: height, airtime and distance for every jump, a public rider profile, 3D replay and Strava description blocks. Early beta.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#04060b" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" as="font" type="font/woff2" href={manropeFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={dmSansFont} crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AIRLOG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
